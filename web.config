<?xml version="1.0" encoding="utf-8"?>
<!--
  File này tồn tại để khai các header bảo mật mà ASP.NET Core không tự gắn. Khi
  `dotnet publish` chạy, SDK đọc web.config sẵn có rồi chèn thêm khối <aspNetCore>
  trỏ tới VoTrongNghia.dll — nên đừng gõ tay khối đó ở đây, nó sẽ bị ghi đè mỗi lần publish.
  Chép từ Dokma, CSP mở thêm đúng những nguồn trang này dùng.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />

        <!--
          script-src 'unsafe-inline': đoạn script nhỏ trong <head> đặt giao diện sáng/tối
          trước khi vẽ trang (không có thì trang nháy trắng lúc tải ở chế độ tối).

          cdn.jsdelivr.net: marked + DOMPurify cho bảng xem trước ở trang AI Templates —
          nội dung xem trước tải thẳng từ GitHub (raw.githubusercontent.com, connect-src).

          i.ytimg.com và www.youtube-nocookie.com: ảnh và khung video YouTube trong mục
          Video và trong bài học. Chỉ hiện khi đã điền kênh / mã video.

          Google Fonts: stylesheet ở fonts.googleapis.com, file font ở fonts.gstatic.com.
          Trang quản trị không gọi CDN nào, thư viện nằm trong wwwroot/lib.

          Phần giá trị thật nằm ở object-src, base-uri, form-action và frame-ancestors:
          chúng chặn được ngay cả khi có script lạ chen vào.
        -->
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com; frame-src https://www.youtube-nocookie.com; connect-src 'self' https://raw.githubusercontent.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
