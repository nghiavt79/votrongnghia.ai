@page "/ai-templates"
@{
    ViewData["Title"] = "AI Templates - Kho Skill, Agent & Công cụ cho Claude Code";
    ViewData["Description"] = "Gần 2.000 skill, lệnh, trợ lý, kết nối MCP cho Claude Code, xếp theo việc bạn cần làm — xem trước và cài đặt bằng một lệnh.";
}
@*
    Trang tĩnh hoàn toàn: dữ liệu ở wwwroot/assets/data/ai-templates.json (script
    scripts/update-ai-templates.py tạo ra) và ai-templates-vi.json (bản dịch, sửa tay). Nhóm việc,
    mẫu chọn sẵn và lời giải thích từng loại nằm ở assets/js/ai-templates-vi.js (sửa tay).
    Bảng xem trước tải nội dung gốc từ GitHub, dựng bằng marked + DOMPurify (CDN, đã mở trong CSP).

    Trang xếp theo VIỆC người học cần làm, không theo loại kỹ thuật như thư viện gốc (aitmpl.com):
    khán giả của site phần lớn chưa biết Skill / Agent / MCP khác nhau thế nào. Loại chỉ là bộ lọc phụ.
*@

<main class="page tpl-page">
    <div class="container">
        <section class="tpl-intro">
            <p class="tpl-eyebrow">AI Templates · thư viện miễn phí cho Claude Code</p>
            <h1>Bạn muốn AI giúp việc gì?</h1>
            <p class="lead-sm"><strong id="statTotal">Gần 2.000</strong> mẫu dựng sẵn — cài vào là Claude làm được việc đó tốt hơn. Chọn một nhóm việc, hoặc gõ thử <em>"email"</em>, <em>"excel"</em>, <em>"slide"</em>.</p>
            <label class="tpl-search">
                <span aria-hidden="true">🔍</span>
                <input type="search" id="tplSearch" placeholder="Tìm theo việc, tên mẫu, công cụ… (phím /)" aria-label="Tìm mẫu" autocomplete="off" />
            </label>
            <ol class="tpl-howto">
                <li><span>1</span>Chọn việc bạn cần</li>
                <li><span>2</span>Bấm một mẫu, đọc trước nội dung</li>
                <li><span>3</span>Chép lệnh cài, chạy trong thư mục dự án</li>
            </ol>
        </section>

        <nav class="tpl-groups" id="tplGroups" aria-label="Nhóm việc"></nav>

        <section class="tpl-starters" id="tplStarters" hidden>
            <h2>⭐ Mới dùng Claude Code? Bắt đầu từ đây</h2>
            <p class="muted">Những mẫu cho việc văn phòng hằng ngày, cài một lệnh là dùng được.</p>
            <div class="tpl-starter-grid" id="tplStarterGrid"></div>
        </section>

        <section class="tpl-results" id="tplResults">
            <div class="tpl-results-head">
                <h2 id="tplHeading">Tất cả mẫu</h2>
                <button type="button" class="tpl-reset" id="tplReset" hidden>✕ Bỏ lọc</button>
            </div>

            <div class="tpl-filters">
                <div class="tpl-types" id="tplTypes" role="group" aria-label="Loại mẫu"></div>
                <div class="tpl-filter-row">
                    <select id="tplCat" class="select" aria-label="Chủ đề" hidden></select>
                    <select id="tplSort" class="select" aria-label="Sắp xếp">
                        <option value="pop">Nhiều người cài nhất</option>
                        <option value="az">Tên A → Z</option>
                    </select>
                    <div class="seg" id="langSwitch" role="group" aria-label="Ngôn ngữ mô tả">
                        <button type="button" data-lang="vi">Tiếng Việt</button><button type="button" data-lang="en">English</button>
                    </div>
                </div>
                <details class="tpl-typehelp">
                    <summary>Nên chọn loại nào?</summary>
                    <dl id="tplTypeHelp"></dl>
                </details>
            </div>

            <p class="muted tpl-count" id="tplCount" aria-live="polite"></p>
            <div class="tpl-list" id="tplList"><p class="muted">Đang tải thư viện…</p></div>
            <div class="center"><button type="button" class="btn btn-ghost" id="tplMore" hidden>Xem thêm</button></div>

            <p class="muted tpl-credit">
                Dữ liệu từ thư viện mã nguồn mở <a href="https://github.com/davila7/claude-code-templates" target="_blank" rel="noopener">claude-code-templates</a>
                (<a href="https://www.aitmpl.com" target="_blank" rel="noopener">aitmpl.com</a>) của Daniel Ávila, giấy phép MIT. Mô tả tiếng Việt và cách xếp theo nhóm việc do votrongnghia.vn biên soạn.
                <span id="tplUpdated"></span> Cài mẫu cần <a href="https://nodejs.org" target="_blank" rel="noopener">Node.js</a>; chưa biết Claude Code? Đọc <a href="/bai-viet/claude-code-101">Claude Code 101</a>.
            </p>
        </section>
    </div>
</main>

<!-- Bảng chi tiết -->
<div class="drawer-backdrop" id="drawerBg" hidden></div>
<aside class="drawer" id="drawer" aria-hidden="true" role="dialog" aria-labelledby="dName">
    <button class="icon-btn drawer-close" id="drawerClose" aria-label="Đóng">✕</button>
    <div class="drawer-body" id="drawerBody"></div>
</aside>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/marked@@12.0.2/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@@3.1.6/dist/purify.min.js"></script>
    <script src="/assets/js/ai-templates-vi.js" asp-append-version="true"></script>
    <script src="/assets/js/ai-templates.js" asp-append-version="true"></script>
}
