@*
    Khung trang quản trị, dựng trên AdminLTE 4 + Bootstrap 5 — cùng khuôn với /cms của
    Dokma và kimthyland.

    Thư viện nạp từ wwwroot/lib chứ không từ CDN: trang quản trị không nên phụ thuộc
    vào một máy chủ bên thứ ba còn sống hay không.
*@
@inject VoTrongNghia.Services.RegistrationStore Registrations
@{
    var current = ViewContext.RouteData.Values["page"] as string ?? string.Empty;

    // Số đơn đăng ký chưa ai đọc, hiện cạnh mục Đơn đăng ký ở mọi trang quản trị.
    var donMoi = await Registrations.CountNewAsync();

    string Active(string prefix) =>
        current.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Title"] ?? "Quản trị") · votrongnghia.vn</title>
    <link rel="icon" href="~/assets/img/avatar.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/adminlte/css/adminlte.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary vn-admin">
<div class="app-wrapper">

    <nav class="app-header navbar navbar-expand bg-body">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Thu gọn menu">
                        <i class="bi bi-list"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="/" class="nav-link" target="_blank" rel="noopener">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Xem site
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto align-items-center">
                <li class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" role="button"
                       aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i>@User.Identity!.Name
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-page="/Admin/DoiMatKhau">
                                <i class="bi bi-key me-2"></i>Đổi mật khẩu
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            @* Đăng xuất chỉ nhận POST, nên đây là nút trong form chứ
                               không phải link — xem Pages/Admin/DangXuat.cshtml.cs. *@
                            <form method="post" asp-page="/Admin/DangXuat">
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>

    <aside class="app-sidebar shadow" data-bs-theme="dark">
        <div class="sidebar-brand">
            <a asp-page="/Admin/Index" class="brand-link">
                <span class="brand-image vn-monogram">VN</span>
                <span class="brand-text fw-light">votrongnghia.vn</span>
            </a>
        </div>

        <div class="sidebar-wrapper">
            <nav class="mt-2">
                <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
                    <li class="nav-item">
                        <a asp-page="/Admin/Index" class="nav-link @(current == "/Admin/Index" ? "active" : "")">
                            <i class="nav-icon bi bi-speedometer2"></i>
                            <p>Bảng điều khiển</p>
                        </a>
                    </li>

                    <li class="nav-header">LỚP ONLINE</li>
                    <li class="nav-item">
                        <a asp-page="/Admin/DangKy/Index" class="nav-link @Active("/Admin/DangKy")">
                            <i class="nav-icon bi bi-person-lines-fill"></i>
                            <p>
                                Đơn đăng ký
                                @if (donMoi > 0)
                                {
                                    <span class="nav-badge badge text-bg-danger ms-auto">@donMoi</span>
                                }
                            </p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-page="/Admin/LopOnline" class="nav-link @Active("/Admin/LopOnline")">
                            <i class="nav-icon bi bi-calendar-event"></i>
                            <p>Lịch &amp; điều kiện</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-page="/Admin/Email" class="nav-link @Active("/Admin/Email")">
                            <i class="nav-icon bi bi-envelope-at"></i>
                            <p>Gửi email (Gmail)</p>
                        </a>
                    </li>

                    <li class="nav-header">NỘI DUNG</li>
                    <li class="nav-item">
                        <a asp-page="/Admin/BaiViet/Index" class="nav-link @Active("/Admin/BaiViet")">
                            <i class="nav-icon bi bi-newspaper"></i>
                            <p>Bài viết</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-page="/Admin/KhoaHoc/Index" class="nav-link @Active("/Admin/KhoaHoc")">
                            <i class="nav-icon bi bi-mortarboard"></i>
                            <p>Khóa học</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-page="/Admin/ThongKe" class="nav-link @Active("/Admin/ThongKe")">
                            <i class="nav-icon bi bi-bar-chart-line"></i>
                            <p>Thống kê học</p>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-page="/Admin/ThongTin" class="nav-link @Active("/Admin/ThongTin")">
                            <i class="nav-icon bi bi-person-badge"></i>
                            <p>Thông tin trang</p>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </aside>

    <main class="app-main">
        <div class="app-content-header">
            <div class="container-fluid">
                <div class="row align-items-center g-2">
                    <div class="col-sm">
                        <h3 class="mb-0">@ViewData["Title"]</h3>
                        @if (ViewData["Subtitle"] is string subtitle)
                        {
                            <p class="mb-0 small text-body-secondary">@subtitle</p>
                        }
                    </div>
                    <div class="col-sm-auto">
                        @await RenderSectionAsync("Actions", required: false)
                    </div>
                </div>
            </div>
        </div>

        <div class="app-content">
            <div class="container-fluid pb-4">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="app-footer">
        <div class="float-end d-none d-sm-inline">votrongnghia.vn</div>
        <strong>Quản trị nội dung</strong> — chỉ nội bộ, không hiện trên site.
    </footer>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/lib/adminlte/js/adminlte.min.js" asp-append-version="true"></script>
<script src="~/js/admin.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
