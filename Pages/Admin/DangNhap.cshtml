@page "/cms"
@model VoTrongNghia.Pages.Admin.DangNhapModel
@{
    // Trang đứng một mình: không dùng khung quản trị (thanh bên, menu, chân
    // trang) vì chưa đăng nhập thì chưa có gì để điều hướng, cũng không nạp
    // AdminLTE cho một biểu mẫu hai ô.
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Đăng nhập · Quản trị votrongnghia.ai</title>
    <link rel="icon" href="~/assets/img/avatar.svg" />
    <link rel="stylesheet" href="~/css/admin-login.css" asp-append-version="true" />
</head>
<body>
<main class="lg-shell">

    <section class="lg-brand">
        <div class="lg-brand__mark">
            <span>VN</span>
            VOTRONGNGHIA.AI
        </div>

        <div class="lg-brand__body">
            <h1>Khu vực quản trị nội dung</h1>
            <p>
                Nơi viết bài, soạn khóa học, lên lịch lớp online và duyệt đơn đăng ký
                của người học. Lưu ở đây là khách tải lại trang thấy ngay.
            </p>

            <ul class="lg-brand__list">
                <li>
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Viết bài và bài học bằng Markdown, xem trước trước khi đăng
                </li>
                <li>
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Đọc và duyệt đơn đăng ký lớp online, xuất danh sách học viên
                </li>
                <li>
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Tự kiểm bài quá ngắn, chỗ trống chưa điền và đường dẫn trùng
                </li>
            </ul>
        </div>

        <p class="lg-brand__foot">Chia sẻ kiến thức AI miễn phí, lan tỏa cho mọi người</p>
    </section>

    <section class="lg-panel">
        <div class="lg-card">

@* ---------- Lần đầu: máy chủ chưa có tài khoản nào ----------

   Không bắt ai mở dòng lệnh. Publish lên, mở /cms, đặt tài khoản ngay tại đây.
   Biểu mẫu này biến mất vĩnh viễn ngay khi có tài khoản đầu tiên.
*@
@if (!Model.HasAccount)
{
    <h2>Tạo tài khoản quản trị</h2>
    <p class="lg-card__sub">
        Website vừa dựng xong và chưa có ai quản lý. Đặt tài khoản đầu tiên ngay bây giờ.
    </p>

    <div class="lg-note">
        Chưa đặt tài khoản thì ai mở trang này trước người đó cầm chìa khoá.
        Đặt ngay để khoá cửa lại.
    </div>

    <form method="post" asp-page-handler="TaoTaiKhoan" novalidate>
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="lg-alert" role="alert">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
                    <path d="M12 7.5v5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    <circle cx="12" cy="16.2" r="1.1" fill="currentColor" />
                </svg>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div class="lg-field">
            <label asp-for="NewUserName">Tên đăng nhập</label>
            <div class="lg-input-wrap">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.8" />
                    <path d="M4.8 19.5c1.3-3.3 4-5 7.2-5s5.9 1.7 7.2 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <input asp-for="NewUserName" autocomplete="username" autocapitalize="none"
                       spellcheck="false" autofocus placeholder="Tên đăng nhập" />
            </div>
        </div>

        <div class="lg-field">
            <label asp-for="NewPassword">Mật khẩu</label>
            <div class="lg-input-wrap">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="4.5" y="10.5" width="15" height="9.5" rx="2" stroke="currentColor" stroke-width="1.8" />
                    <path d="M8 10.5V8a4 4 0 1 1 8 0v2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <input asp-for="NewPassword" type="password" autocomplete="new-password"
                       placeholder="Từ @VoTrongNghia.Pages.Admin.DangNhapModel.MinimumPasswordLength ký tự" />
            </div>
        </div>

        <div class="lg-field">
            <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
            <div class="lg-input-wrap">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="4.5" y="10.5" width="15" height="9.5" rx="2" stroke="currentColor" stroke-width="1.8" />
                    <path d="M8 10.5V8a4 4 0 1 1 8 0v2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                       placeholder="Nhập lại cho chắc" />
            </div>
        </div>

        <button type="submit" class="lg-btn">
            Tạo tài khoản và vào quản trị
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </form>

    <a class="lg-back" href="/">&larr; Về trang chủ</a>
}
else
{
            <h2>Đăng nhập</h2>
            <p class="lg-card__sub">Nhập tài khoản quản trị để tiếp tục.</p>

            <form method="post" novalidate>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="lg-alert" role="alert">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
                            <path d="M12 7.5v5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            <circle cx="12" cy="16.2" r="1.1" fill="currentColor" />
                        </svg>
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="lg-field">
                    <label asp-for="UserName">Tên đăng nhập</label>
                    <div class="lg-input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="8" r="3.6" stroke="currentColor" stroke-width="1.8" />
                            <path d="M4.8 19.5c1.3-3.3 4-5 7.2-5s5.9 1.7 7.2 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                        <input asp-for="UserName" autocomplete="username" autocapitalize="none"
                               spellcheck="false" autofocus placeholder="Tên đăng nhập" />
                    </div>
                </div>

                <div class="lg-field">
                    <label asp-for="Password">Mật khẩu</label>
                    <div class="lg-input-wrap">
                        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <rect x="4.5" y="10.5" width="15" height="9.5" rx="2" stroke="currentColor" stroke-width="1.8" />
                            <path d="M8 10.5V8a4 4 0 1 1 8 0v2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                        </svg>
                        <input asp-for="Password" type="password" autocomplete="current-password"
                               placeholder="Mật khẩu" id="matKhau" />
                        <button type="button" class="lg-eye" id="hienMatKhau"
                                aria-label="Hiện mật khẩu" aria-pressed="false" title="Hiện mật khẩu">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                <path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8" />
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="lg-btn">
                    Đăng nhập
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </form>

            <a class="lg-back" href="/">&larr; Về trang chủ</a>
}

        </div>
    </section>

</main>

<script>
    // Nút con mắt: hiện / ẩn mật khẩu. Chỉ có mỗi việc này nên viết thẳng ở đây,
    // không kéo cả admin.js về cho một trang chưa đăng nhập.
    (function () {
        var eye = document.getElementById('hienMatKhau');
        var pwd = document.getElementById('matKhau');

        if (!eye || !pwd) {
            return;
        }

        eye.addEventListener('click', function () {
            var show = pwd.type === 'password';
            pwd.type = show ? 'text' : 'password';
            eye.setAttribute('aria-pressed', show ? 'true' : 'false');
            eye.setAttribute('aria-label', show ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
            eye.setAttribute('title', show ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
            pwd.focus();
        });
    })();
</script>
</body>
</html>
