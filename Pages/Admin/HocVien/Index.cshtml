@page "/cms/hoc-vien"
@model VoTrongNghia.Pages.Admin.HocVien.IndexModel
@{
    ViewData["Title"] = "Học viên";
    ViewData["Subtitle"] = $"{Model.Total} học viên · {Model.CountByStatus.GetValueOrDefault(Learner.StatusActive)} đang học · {Model.IdleCount} không học quá {LearnerStore.IdleDays} ngày";
}

@if (Model.ExpiredCount > 0)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
        <span><i class="bi bi-shield-lock me-1"></i>Có <strong>@Model.ExpiredCount học viên</strong> không hoạt động quá @RegistrationStore.RetentionMonths tháng —
            trang <a href="/chinh-sach-du-lieu" target="_blank" rel="noopener">chính sách dữ liệu</a> cam kết không giữ thông tin cá nhân lâu hơn.</span>
        <form method="post" asp-page-handler="AnDanh" class="ms-auto">
            <button type="submit" class="btn btn-sm btn-warning" data-confirm="Xoá tên, email, điện thoại của @Model.ExpiredCount học viên và khoá tài khoản? Tiến độ học vẫn giữ để đếm.">Ẩn danh hoá ngay</button>
        </form>
    </div>
}

@if (Model.ApprovedWithoutAccount > 0)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <span><i class="bi bi-person-plus me-1"></i><strong>@Model.ApprovedWithoutAccount đơn đã duyệt</strong> chưa gắn với tài khoản học viên (duyệt trước khi có trang học viên).</span>
        <form method="post" asp-page-handler="TuDon" class="ms-auto">
            <button type="submit" class="btn btn-sm btn-primary">Tạo tài khoản (không gửi thư)</button>
        </form>
    </div>
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <div class="btn-group flex-wrap" role="group" aria-label="Lọc học viên">
            <a class="btn btn-sm @(Model.Filter.Length == 0 ? "btn-brand" : "btn-outline-secondary")" asp-route-loc="">Tất cả (@Model.Total)</a>
            <a class="btn btn-sm @(Model.Filter == VoTrongNghia.Pages.Admin.HocVien.IndexModel.FilterIdle ? "btn-brand" : "btn-outline-secondary")" asp-route-loc="@VoTrongNghia.Pages.Admin.HocVien.IndexModel.FilterIdle">
                Không học quá @LearnerStore.IdleDays ngày (@Model.IdleCount)
            </a>
            @foreach (var (key, label, _) in Learner.Statuses)
            {
                <a class="btn btn-sm @(Model.Filter == key ? "btn-brand" : "btn-outline-secondary")" asp-route-loc="@key">
                    @label (@Model.CountByStatus.GetValueOrDefault(key))
                </a>
            }
        </div>
    </div>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card shadow-sm mb-3">
        <div class="card-body text-center py-5 text-body-secondary">
            <i class="bi bi-people fs-1 d-block mb-2 text-body-tertiary"></i>
            @(Model.Total == 0
                ? "Chưa có học viên nào. Tài khoản tự tạo khi bạn duyệt một đơn đăng ký."
                : "Không có học viên nào khớp bộ lọc.")
        </div>
    </div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th scope="col">Học viên</th>
                    @foreach (var course in Model.Courses)
                    {
                        <th scope="col" class="small" title="@course.Title">Cấp @course.Level</th>
                    }
                    <th scope="col">Lần học gần nhất</th>
                    <th scope="col">Trạng thái</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <a class="text-decoration-none fw-semibold" asp-page="/Admin/HocVien/ChiTiet" asp-route-id="@item.Id">@item.Name</a>
                            <div class="small text-body-secondary">@item.Email</div>
                        </td>
                        @foreach (var course in Model.Courses)
                        {
                            var done = Model.Done(item, course);
                            var percent = (int)Math.Round(100.0 * done / course.Lessons.Count);
                            <td class="small" style="min-width:90px">
                                <div class="progress" role="progressbar" style="height:6px" aria-label="@course.Title" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar @(done == course.Lessons.Count ? "bg-success" : "")" style="width:@percent%"></div>
                                </div>
                                <span class="text-body-secondary">@done/@course.Lessons.Count</span>
                            </td>
                        }
                        <td class="small text-nowrap @(LearnerStore.IsIdle(item) ? "text-danger fw-semibold" : "")">
                            @item.LastActivity.ToString("dd/MM/yyyy")
                            <div class="fw-normal text-body-secondary">@SiteTime.DaysAgo(item.LastActivity)</div>
                        </td>
                        <td><span class="badge @item.StatusBadge">@item.StatusLabel</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header"><h5 class="card-title mb-0"><i class="bi bi-person-plus me-1"></i>Thêm học viên</h5></div>
    <form method="post" asp-page-handler="Them">
        <div class="card-body">
            @if (Model.Error is not null)
            {
                <div class="alert alert-danger py-2 small">@Model.Error</div>
            }
            <p class="small text-body-secondary">Cho người bạn hướng dẫn ngoài form đăng ký. Bình thường không cần: duyệt đơn là tài khoản tự tạo.</p>
            <div class="row g-2">
                <div class="col-md-4"><input class="form-control" asp-for="NewName" placeholder="Họ tên" maxlength="80" /></div>
                <div class="col-md-4"><input class="form-control" asp-for="NewEmail" type="email" placeholder="Email" maxlength="120" /></div>
                <div class="col-md-2"><input class="form-control" asp-for="NewPhone" placeholder="SĐT (không bắt buộc)" maxlength="15" /></div>
                <div class="col-md-2 d-grid"><button type="submit" class="btn btn-brand">Thêm</button></div>
            </div>
        </div>
    </form>
</div>
