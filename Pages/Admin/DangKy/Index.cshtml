@page "/cms/dang-ky"
@model VoTrongNghia.Pages.Admin.DangKy.IndexModel
@{
    ViewData["Title"] = "Đơn đăng ký";
    ViewData["Subtitle"] = $"{Model.Total} đơn · {Model.CountByStatus.GetValueOrDefault(Registration.StatusNew)} đơn mới chưa đọc";
}

@section Actions {
    <a class="btn btn-outline-secondary" asp-page-handler="Csv" asp-route-trangThai="@Model.Status" asp-route-buoi="@Model.Session">
        <i class="bi bi-filetype-csv me-1"></i>Xuất CSV (@Model.Items.Count đơn)
    </a>
}

@if (Model.ExpiredCount > 0)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
        <span><i class="bi bi-shield-lock me-1"></i>Có <strong>@Model.ExpiredCount đơn</strong> quá @RegistrationStore.RetentionMonths tháng —
            trang <a href="/chinh-sach-du-lieu" target="_blank" rel="noopener">chính sách dữ liệu</a> cam kết không giữ thông tin cá nhân lâu hơn.</span>
        <form method="post" asp-page-handler="AnDanh" class="ms-auto">
            <button type="submit" class="btn btn-sm btn-warning" data-confirm="Xoá họ tên, email, điện thoại, câu trả lời của @Model.ExpiredCount đơn cũ? Số liệu đếm vẫn giữ.">Ẩn danh hoá ngay</button>
        </form>
    </div>
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center">
        <div class="btn-group flex-wrap" role="group" aria-label="Lọc theo trạng thái">
            <a class="btn btn-sm @(Model.Status.Length == 0 ? "btn-brand" : "btn-outline-secondary")" asp-route-buoi="@Model.Session">Tất cả (@Model.Total)</a>
            @foreach (var (key, label, _) in Registration.Statuses)
            {
                <a class="btn btn-sm @(Model.Status == key ? "btn-brand" : "btn-outline-secondary")" asp-route-trangThai="@key" asp-route-buoi="@Model.Session">
                    @label (@Model.CountByStatus.GetValueOrDefault(key))
                </a>
            }
        </div>
        @if (Model.Sessions.Count > 0)
        {
            <form method="get" class="ms-auto d-flex gap-2">
                <input type="hidden" name="trangThai" value="@Model.Status" />
                <select class="form-select form-select-sm" name="buoi" data-tu-gui aria-label="Lọc theo buổi">
                    <option value="">Mọi buổi</option>
                    @foreach (var session in Model.Sessions)
                    {
                        <option value="@session.Id" selected="@(Model.Session == session.Id)">@session.Label</option>
                    }
                </select>
            </form>
        }
    </div>
</div>

@if (Model.Items.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5 text-body-secondary">
            <i class="bi bi-inbox fs-1 d-block mb-2 text-body-tertiary"></i>
            @(Model.Total == 0 ? "Chưa có đơn nào." : "Không có đơn nào khớp bộ lọc.")
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th scope="col">Người đăng ký</th>
                    <th scope="col">Mức AI · giờ/tuần</th>
                    <th scope="col">Buổi</th>
                    <th scope="col">Gửi lúc</th>
                    <th scope="col">Trạng thái</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr class="@(item.Status == Registration.StatusNew ? "fw-semibold" : "")">
                        <td>
                            <a class="text-decoration-none" asp-page="/Admin/DangKy/ChiTiet" asp-route-ma="@item.Code">@item.Name</a>
                            <div class="small text-body-secondary fw-normal">@item.Job · <code>@item.Code</code></div>
                        </td>
                        <td class="small fw-normal">@item.AiLevel<br />@item.HoursLabel</td>
                        <td class="small fw-normal">@(item.SessionLabel.Length > 0 ? item.SessionLabel : "Chưa có lịch")</td>
                        <td class="small text-nowrap fw-normal">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @item.StatusBadge">@item.StatusLabel</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
