@page
@model VoTrongNghia.Pages.IndexModel
@{
    var site = Model.Site;
    ViewData["Description"] = site.HeroDescription;
    ViewData["Canonical"] = "/";
}

<main id="home">
    <section class="hero">
        <div class="hero-bg"></div>
        <div class="container hero-inner">
            @if (site.Badge.Length > 0)
            {
                <span class="pill">@site.Badge</span>
            }
            <h1>@site.HeroLead<br /><span class="gradient-text">@site.Name</span></h1>
            <p class="lead">@site.HeroDescription</p>
            <div class="hero-cta">
                <a href="/khoa-hoc" class="btn btn-primary">🎓 Khóa học AI miễn phí</a>
                <a href="#hoc-online" class="btn btn-ghost">🎥 Học online miễn phí</a>
                <a href="/ai-templates" class="btn btn-ghost">🧩 AI Templates</a>
                @if (site.Tools.Count > 0)
                {
                    <a href="#cong-cu" class="btn btn-ghost">✨ Công cụ AI hàng đầu</a>
                }
                @if (site.ShowVideos)
                {
                    <a href="#videos" class="btn btn-ghost">▶ Video mới nhất</a>
                }
                <a href="/bai-viet" class="btn btn-ghost">📰 Bài viết mới nhất</a>
            </div>
        </div>
    </section>

    @if (site.Audiences.Count > 0)
    {
        @* Ngay dưới đầu trang: người mới vào biết ngay trang có dành cho mình không, và bắt đầu từ đâu. *@
        <section class="section" id="danh-cho-ai">
            <div class="container">
                <div class="section-head reveal">
                    <h2>Trang Này Dành Cho Ai?</h2>
                    <p>Không cần biết lập trình hay rành công nghệ — chỉ cần bạn muốn làm việc nhẹ nhàng hơn nhờ AI.</p>
                </div>
                <div class="grid grid-@Math.Min(site.Audiences.Count, 4) audiences">
                    @foreach (var audience in site.Audiences)
                    {
                        <div class="card audience reveal">
                            <span class="tool-icon">@audience.Icon</span>
                            <h3>@audience.Title</h3>
                            <p>@audience.Description</p>
                            @if (audience.Link.Length > 0)
                            {
                                <a class="audience-link" href="@audience.Link">Bắt đầu từ đây →</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="section" id="gioi-thieu">
        <div class="container">
            <div class="card about reveal">
                <img class="about-avatar" src="/@site.Avatar" alt="Ảnh đại diện @site.Name" />
                <div>
                    <h2>@site.Name</h2>
                    <p class="about-role">@site.Title</p>
                    <p>@site.Bio</p>
                    @if (site.Story.Count > 0)
                    {
                        <h3 class="story-head">Hành trình của mình</h3>
                        <ol class="story">
                            @foreach (var step in site.Story)
                            {
                                <li><span class="story-icon">@step.Icon</span><div><strong>@step.Title</strong><small>@step.Description</small></div></li>
                            }
                        </ol>
                    }
                    <div class="chips">
                        @if (site.Youtube.Length > 0) { <a class="chip" href="@site.Youtube" target="_blank" rel="noopener">▶ Kênh YouTube</a> }
                        @if (site.Facebook.Length > 0) { <a class="chip" href="@site.Facebook" target="_blank" rel="noopener">📘 Facebook</a> }
                        @if (site.FacebookGroup.Length > 0) { <a class="chip" href="@site.FacebookGroup" target="_blank" rel="noopener">👥 Nhóm Facebook</a> }
                        @if (site.Zalo.Length > 0) { <a class="chip" href="@site.Zalo" target="_blank" rel="noopener">💬 Zalo</a> }
                        @if (site.ZaloGroup.Length > 0) { <a class="chip" href="@site.ZaloGroup" target="_blank" rel="noopener">👥 Nhóm Zalo</a> }
                    </div>
                </div>
            </div>
        </div>
    </section>

    @if (site.Cases.Count > 0)
    {
        <section class="section alt" id="viec-that">
            <div class="container">
                <div class="section-head reveal">
                    <h2>Mình Dùng AI Để Làm…</h2>
                    <p>Những việc thật mình đã làm bằng AI — để bạn thấy nó áp dụng được ngay, không chỉ là lý thuyết.</p>
                </div>
                <div class="grid grid-3">
                    @foreach (var item in site.Cases)
                    {
                        <div class="card case reveal">
                            @if (item.Result.Length > 0)
                            {
                                <span class="case-result">@item.Result</span>
                            }
                            <h3>@item.Title</h3>
                            <p>@item.Description</p>
                            @if (item.Link.Length > 0)
                            {
                                <a class="audience-link" href="@item.Link">Xem mình làm thế nào →</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (site.Tools.Count > 0)
    {
        <section class="section" id="cong-cu">
            <div class="container">
                <div class="section-head reveal">
                    <h2>Công Cụ AI Tôi Sử Dụng</h2>
                    <p>@site.Tools.Count công cụ AI mình đang dùng thực tế cho lập trình, tạo nội dung và công việc hằng ngày.</p>
                    <input type="search" id="toolSearch" class="search" placeholder="🔍 Tìm công cụ theo tên…" aria-label="Tìm công cụ" />
                </div>
                <div class="grid grid-3" id="toolGrid">
                    @foreach (var tool in site.Tools)
                    {
                        <a class="card tool reveal" href="@tool.Url" target="_blank" rel="noopener" data-search="@($"{tool.Name} {tool.Description}".ToLowerInvariant())">
                            <span class="tool-icon">@tool.Icon</span>
                            <span class="tool-text"><strong>@tool.Name</strong><small>@tool.Description</small></span>
                            <span class="arrow">↗</span>
                        </a>
                    }
                </div>
                <p class="empty" id="toolEmpty" hidden>Không tìm thấy công cụ phù hợp.</p>
            </div>
        </section>
    }

    @if (site.ShowVideos)
    {
        <section class="section alt" id="videos">
            <div class="container">
                <div class="section-head reveal">
                    <h2>Video Mới Nhất</h2>
                    <p>Video hướng dẫn, chia sẻ kiến thức và cập nhật mới nhất về AI trên kênh YouTube.</p>
                </div>
                <div class="grid grid-3" id="videoGrid">
                    @foreach (var video in site.Videos)
                    {
                        <article class="card video reveal">
                            @* Chỉ nhúng khung YouTube khi bấm: 6 khung nhúng sẵn là vài MB script tải vô ích. *@
                            <button class="thumb" data-id="@video.YoutubeId" aria-label="Phát video @video.Title">
                                <img loading="lazy" src="https://i.ytimg.com/vi/@video.YoutubeId/hqdefault.jpg" alt="" />
                                <span class="play">▶</span>
                            </button>
                            <h3>@video.Title</h3>
                        </article>
                    }
                </div>
                <div class="center"><a class="btn btn-ghost" href="@site.Youtube" target="_blank" rel="noopener">Xem thêm trên YouTube →</a></div>
            </div>
        </section>
    }

    @if (Model.Courses.Count > 0)
    {
        <section class="section" id="khoa-hoc">
            <div class="container">
                <div class="section-head reveal">
                    <h2>Khóa Học AI Miễn Phí</h2>
                    <p>100% miễn phí, không cần đăng ký. Bài học chia theo @Model.Courses.Count cấp độ, giúp bạn làm chủ AI từ con số 0.</p>
                </div>
                <div class="grid grid-4">
                    @foreach (var course in Model.Courses)
                    {
                        <partial name="_CourseCard" model="course" />
                    }
                </div>
            </div>
        </section>
    }

    <section class="section alt" id="hoc-online">
        <div class="container">
            <div class="section-head reveal">
                <span class="pill">🎁 100% miễn phí</span>
                <h2 style="margin-top:16px">Học Online Cùng Mình</h2>
                <p>Các buổi hướng dẫn trực tuyến miễn phí — mình hướng dẫn từng bước, bạn làm theo và hỏi trực tiếp.</p>
            </div>
            <div class="grid grid-4 live-perks">
                <div class="card reveal"><span class="tool-icon">🎥</span><h3>Trực tuyến</h3><p>Học qua Zoom / Google Meet, ở đâu cũng tham gia được.</p></div>
                <div class="card reveal"><span class="tool-icon">🙋</span><h3>Hỏi đáp trực tiếp</h3><p>Vướng chỗ nào hỏi ngay, mình giải đáp tại chỗ.</p></div>
                <div class="card reveal"><span class="tool-icon">🛠️</span><h3>Thực hành thật</h3><p>Làm ra sản phẩm ngay trong buổi, không chỉ nghe lý thuyết.</p></div>
                <div class="card reveal"><span class="tool-icon">💛</span><h3>Miễn phí, cần cam kết</h3><p>Không thu phí — đổi lại bạn cam kết học nghiêm túc và lan tỏa cho người khác.</p></div>
            </div>

            <partial name="_LiveCriteria" model="Model.Live" />

            @if (Model.Sessions.Count > 0)
            {
                <h3 class="live-head">📅 Lịch sắp tới</h3>
                <div class="live-list">
                    @foreach (var session in Model.Sessions)
                    {
                        <div class="card live-item reveal">
                            <div class="live-date"><strong>@session.Date.Day</strong><span>Th@(session.Date.Month)</span></div>
                            <div class="live-info">
                                <h3>@session.Title</h3>
                                @if (session.Description.Length > 0)
                                {
                                    <p>@session.Description</p>
                                }
                                <span class="muted">🕗 @session.Time · 💻 @session.Platform@(session.Capacity > 0 ? $" · 👥 {session.Capacity} chỗ" : "")</span>
                            </div>
                            <a class="btn btn-primary" href="/dang-ky?buoi=@session.Id">Đăng ký</a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card live-empty reveal">
                    <h3>🚀 Sắp khai giảng!</h3>
                    <p>Lớp miễn phí nhưng số chỗ có hạn, nên mình ưu tiên những bạn <strong>thực sự nghiêm túc và cam kết theo đến cùng</strong>. Đăng ký trước để được xét duyệt và báo lịch sớm nhất.</p>
                    <a class="btn btn-primary" href="/dang-ky">✍️ Đăng ký tham gia</a>
                </div>
            }
        </div>
    </section>

    @if (Model.Posts.Count > 0)
    {
        <section class="section" id="bai-viet">
            <div class="container">
                <div class="section-head reveal">
                    <h2>Bài Viết</h2>
                    <p>Chia sẻ kiến thức, kinh nghiệm và góc nhìn về AI.</p>
                </div>
                <div class="grid grid-3">
                    @foreach (var post in Model.Posts)
                    {
                        <partial name="_PostCard" model="post" />
                    }
                </div>
                @if (Model.PostCount > Model.Posts.Count)
                {
                    <div class="center"><a class="btn btn-ghost" href="/bai-viet">Xem tất cả @Model.PostCount bài viết →</a></div>
                }
                else
                {
                    <div class="center"><a class="btn btn-ghost" href="/bai-viet">Xem tất cả bài viết →</a></div>
                }
            </div>
        </section>
    }

    @if (site.Testimonials.Count > 0)
    {
        <section class="section" id="cam-nhan">
            <div class="container">
                <div class="section-head reveal">
                    <h2>Học Viên Nói Gì</h2>
                </div>
                <div class="grid grid-3">
                    @foreach (var item in site.Testimonials)
                    {
                        <figure class="card testimonial reveal">
                            <blockquote>“@item.Quote”</blockquote>
                            <figcaption><strong>@item.Name</strong>@if (item.Role.Length > 0) {<span> · @item.Role</span>}</figcaption>
                        </figure>
                    }
                </div>
            </div>
        </section>
    }

    <section class="section" id="cong-dong">
        <div class="container">
            <div class="card community reveal">
                <h2>Tham Gia Cộng Đồng AI Việt Nam</h2>
                <p>Kết nối với những người đam mê AI. Chia sẻ kiến thức, đặt câu hỏi và cùng nhau học hỏi mỗi ngày.</p>
                @if (site.FacebookGroup.Length > 0 || site.ZaloGroup.Length > 0)
                {
                    <div class="chips" style="justify-content:center">
                        @if (site.FacebookGroup.Length > 0)
                        {
                            <a class="btn btn-primary" href="@site.FacebookGroup" target="_blank" rel="noopener">👥 Nhóm Facebook</a>
                        }
                        @if (site.ZaloGroup.Length > 0)
                        {
                            <a class="btn btn-primary" href="@site.ZaloGroup" target="_blank" rel="noopener">💬 Nhóm Zalo</a>
                        }
                    </div>
                }
                else
                {
                    <a class="btn btn-primary" href="/dang-ky">✍️ Đăng ký lớp học online</a>
                }
            </div>
            @if (site.Socials().Any())
            {
                <div class="section-head reveal" style="margin-top:64px">
                    <h2>Theo Dõi Mình</h2>
                    <p>Theo dõi trên các nền tảng khác để không bỏ lỡ nội dung mới.</p>
                </div>
                <div class="grid grid-3">
                    @foreach (var (name, description, icon, url) in site.Socials())
                    {
                        <a class="card tool reveal" href="@url" target="_blank" rel="noopener">
                            <span class="tool-icon">@icon</span>
                            <span class="tool-text"><strong>@name</strong><small>@description</small></span>
                            <span class="arrow">↗</span>
                        </a>
                    }
                </div>
            }
        </div>
    </section>

    @if (site.ShowDonate)
    {
        <section class="section alt" id="ung-ho">
            <div class="container">
                <div class="section-head reveal">
                    <h2>Ủng Hộ Mình Một Ly Cafe ☕</h2>
                    <p>Mọi nội dung đều miễn phí. Nếu bạn muốn, một ly cafe sẽ giúp mình có thêm động lực chia sẻ. Cảm ơn bạn ♥️</p>
                </div>
                <div class="grid grid-2 narrow">
                    @if (site.BankNumber.Length > 0)
                    {
                        <div class="card reveal">
                            <h3>🏦 Chuyển khoản ngân hàng</h3>
                            @if (VietQr.Payload(site) is not null)
                            {
                                @* Ảnh dựng trên máy chủ từ chính thông tin bên dưới — xem Services/VietQr.cs. *@
                                <figure class="donate-qr">
                                    <img src="/ung-ho/qr.svg" width="200" height="200" alt="Mã QR chuyển khoản @site.BankName @site.BankNumber" />
                                    <figcaption>Mở app ngân hàng → <strong>Quét QR</strong>. App hiện tên <strong>@site.BankOwner</strong> là đúng người nhận.</figcaption>
                                    <a class="copy" href="/ung-ho/qr.png?tai=1" download>⬇ Tải ảnh QR</a>
                                </figure>
                            }
                            <dl class="bank">
                                <dt>Ngân hàng</dt><dd>@site.BankName</dd>
                                <dt>Số tài khoản</dt><dd>@site.BankNumber <button class="copy" id="copyAcc" data-number="@site.BankNumber.Replace(" ", "")">Sao chép</button></dd>
                                <dt>Chủ tài khoản</dt><dd>@site.BankOwner</dd>
                            </dl>
                        </div>
                    }
                    @if (site.Paypal.Length > 0)
                    {
                        <div class="card reveal">
                            <h3>💳 PayPal</h3>
                            <p>Ủng hộ an toàn và nhanh chóng qua PayPal.</p>
                            <a class="btn btn-primary" href="@site.Paypal" target="_blank" rel="noopener">Ủng hộ qua PayPal</a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    @if (site.ShowContact)
    {
        <section class="section" id="lien-he">
            <div class="container">
                <div class="card contact-card reveal">
                    <h2>Liên Hệ Với Mình</h2>
                    <p>Có câu hỏi, góp ý hay muốn mình viết về chủ đề nào — cứ nhắn cho mình nhé.</p>
                    <div class="chips" style="justify-content:center">
                        @if (site.Zalo.Length > 0)
                        {
                            <a class="btn btn-primary" href="@site.Zalo" target="_blank" rel="noopener">💬 Nhắn Zalo</a>
                        }
                        @if (site.Email.Length > 0)
                        {
                            <a class="btn @(site.Zalo.Length > 0 ? "btn-ghost" : "btn-primary")" href="mailto:@site.Email">✉️ @site.Email</a>
                        }
                    </div>
                </div>
            </div>
        </section>
    }
</main>

@section Scripts {
    <script src="/assets/js/trang-chu.js" asp-append-version="true"></script>
}
